<Grid Background="{DynamicResource PanelBG}">
    <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
    </Grid.RowDefinitions>
    
    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="5,5,5,10">
        <!-- Установка выбранных программ -->
        <Button Name="BtnInstall" Content="Install Selected" 
            Style="{StaticResource TabButton}"
            Background="Transparent"
            BorderBrush="#16A34A"
            BorderThickness="2"
            Foreground="{DynamicResource TextFG}"/>
        
        <!-- Открытие «Программы и компоненты» -->
        <Button Name="BtnOpenAppwiz" Content="" 
            Style="{StaticResource TabButton}"
            Background="Transparent"
            BorderBrush="#D13438"
            BorderThickness="2"
            Foreground="{DynamicResource TextFG}"/>
        
        <!-- Сброс выбора со счётчиком -->
        <Button Name="BtnClearSelection" Content="" 
            Style="{StaticResource TabButton}"
            Background="Transparent"
            BorderBrush="#64748B"
            BorderThickness="1"
            Foreground="{DynamicResource TextFG}"
            Margin="20,0,0,0"/>
        
        <!-- Спиннер прогресса -->
        <StackPanel Name="InstallProgress" Orientation="Horizontal" 
                   VerticalAlignment="Center" Visibility="Collapsed" Margin="20,0,0,0">
            <Grid Width="20" Height="20" Margin="0,0,10,0">
                <Ellipse Stroke="{DynamicResource TextFG}" StrokeThickness="2" Opacity="0.2"/>
                <Ellipse x:Name="InstallSpinnerEllipse" Stroke="{DynamicResource ButtonBG}" StrokeThickness="2" 
                         StrokeDashArray="1 3" RenderTransformOrigin="0.5,0.5">
                    <Ellipse.RenderTransform>
                        <RotateTransform x:Name="InstallSpinnerRotate" Angle="0"/>
                    </Ellipse.RenderTransform>
                </Ellipse>
                <Grid.Resources>
                    <Storyboard x:Key="SpinnerStoryboard">
                        <DoubleAnimation Storyboard.TargetName="InstallSpinnerRotate"
                                        Storyboard.TargetProperty="Angle"
                                        From="0" To="360" Duration="0:0:1" 
                                        RepeatBehavior="Forever"/>
                    </Storyboard>
                </Grid.Resources>
            </Grid>
            <TextBlock Name="InstallProgressText"
                     Text="" VerticalAlignment="Center" FontSize="12"
                     Foreground="{DynamicResource TextFG}" Opacity="0.7"/>
        </StackPanel>
    </StackPanel>
    
    <TextBlock Name="TabDescriptionInstall" Grid.Row="1"
             Text="" FontSize="12" Opacity="0.7"
             Margin="5,0,5,4"
             Foreground="{DynamicResource TextFG}"
             TextWrapping="Wrap"/>
    
    <TextBlock Name="VpnNoteInstall" Grid.Row="2"
             Text="" FontSize="11" Opacity="0.85"
             Margin="5,0,5,12"
             Foreground="#E67E22"
             TextWrapping="Wrap"/>
    
    <ScrollViewer Grid.Row="3" 
                  Style="{StaticResource TabScrollViewer}"
                  VerticalScrollBarVisibility="Auto" 
                  HorizontalScrollBarVisibility="Disabled" 
                  Padding="5,0">
        <StackPanel Name="CategoriesPanel"/>
    </ScrollViewer>
</Grid>