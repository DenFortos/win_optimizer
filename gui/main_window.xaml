<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Windows Optimizer" Height="900" Width="1500"
        WindowStartupLocation="CenterScreen"
        Name="MainWindow">
    
    <Window.Resources>
        <!-- Цвета тем -->
        <SolidColorBrush x:Key="MainBG" Color="#F5F5F5"/>
        <SolidColorBrush x:Key="PanelBG" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextFG" Color="#333333"/>
        <SolidColorBrush x:Key="ButtonBG" Color="#0078D4"/>
        <SolidColorBrush x:Key="ButtonFG" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#CCCCCC"/>
        <SolidColorBrush x:Key="HeaderBG" Color="#0078D4"/>
        <SolidColorBrush x:Key="HeaderFG" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TabBG" Color="#E0E0E0"/>
        <SolidColorBrush x:Key="TabFG" Color="#333333"/>
        <SolidColorBrush x:Key="TabSelectedBG" Color="#0078D4"/>
        <SolidColorBrush x:Key="TabSelectedFG" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="ComboBoxBG" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="ComboBoxFG" Color="#333333"/>
        <SolidColorBrush x:Key="ComboBoxBorder" Color="#CCCCCC"/>
        
        <!-- INCLUDE: styles.xaml -->
    </Window.Resources>
    
    <Grid Background="{DynamicResource MainBG}" Name="MainGrid"
          TextElement.Foreground="{DynamicResource TextFG}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!-- INCLUDE: header.xaml -->
        
        <!-- Панель поиска -->
        <Grid Grid.Row="1" Margin="10,15,10,15">
            <TextBox Name="SearchBox" 
                    Width="300" Height="35" 
                    HorizontalAlignment="Center"
                    VerticalContentAlignment="Center"
                    FontSize="13"
                    Background="{DynamicResource PanelBG}"
                    Foreground="{DynamicResource TextFG}"
                    BorderBrush="{DynamicResource TextFG}"
                    BorderThickness="1"
                    Tag="🔍 Поиск...">
                    <TextBox.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </TextBox.Resources>
                    <TextBox.Style>
                        <Style TargetType="TextBox">
                            <Setter Property="Background" Value="{DynamicResource ComboBoxBG}"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextFG}"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="TextBox">
                                        <Grid>
                                            <Border Background="{TemplateBinding Background}" 
                                                    BorderBrush="{TemplateBinding BorderBrush}" 
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="8"/>
                                            <ScrollViewer x:Name="PART_ContentHost" 
                                                        Margin="10,0,0,0"
                                                        VerticalAlignment="Center"/>
                                            <TextBlock x:Name="PlaceholderText"
                                                    Text="{TemplateBinding Tag}" 
                                                    Margin="10,0,0,0"
                                                    VerticalAlignment="Center"
                                                    Foreground="{DynamicResource TextFG}"
                                                    Opacity="0.5"
                                                    IsHitTestVisible="False"
                                                    Visibility="Collapsed"/>
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="Text" Value="">
                                                <Setter TargetName="PlaceholderText" Property="Visibility" Value="Visible"/>
                                            </Trigger>
                                            <Trigger Property="Text" Value="{x:Null}">
                                                <Setter TargetName="PlaceholderText" Property="Visibility" Value="Visible"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </TextBox.Style>
                </TextBox>
        </Grid>
        
        <TabControl Grid.Row="2" Margin="10,0,10,10" 
                   Name="MainTabControl">
            <TabItem Header="Install" Name="InstallTab">
                <!-- INCLUDE: install_tab.xaml -->
            </TabItem>
            <TabItem Header="Debloat" Name="TweaksTab">
                <!-- INCLUDE: debloat.xaml -->
            </TabItem>
            <TabItem Header="Optimization" Name="OptimizationTab">
                <!-- INCLUDE: optimization.xaml -->
            </TabItem>
            <TabItem Header="Guide" Name="GuideTab">
                <!-- INCLUDE: guide.xaml -->
            </TabItem>
        </TabControl>
    </Grid>
</Window>