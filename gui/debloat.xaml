<Grid Background="{DynamicResource PanelBG}">
    <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
    </Grid.RowDefinitions>
    
    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="5,5,5,10">
        <!-- Удаление выбранных UWP -->
        <Button Name="BtnApplyTweaks" Content="" 
            Style="{StaticResource TabButton}"
            Background="Transparent"
            BorderBrush="#E67E22"
            BorderThickness="2"
            Foreground="{DynamicResource TextFG}"/>
        
        <!-- Сброс выбора со счётчиком -->
        <Button Name="BtnClearTweaks" Content="" 
            Style="{StaticResource TabButton}"
            Background="Transparent"
            BorderBrush="#64748B"
            BorderThickness="1"
            Foreground="{DynamicResource TextFG}"
            Margin="20,0,0,0"/>
        
        <!-- Спиннер прогресса -->
        <StackPanel Name="TweaksProgress" Orientation="Horizontal" 
                   VerticalAlignment="Center" Visibility="Collapsed" Margin="20,0,0,0">
            <Grid Width="20" Height="20" Margin="0,0,10,0">
                <Ellipse Stroke="{DynamicResource TextFG}" StrokeThickness="2" Opacity="0.2"/>
                <Ellipse x:Name="TweaksSpinnerEllipse" Stroke="{DynamicResource ButtonBG}" StrokeThickness="2" 
                         StrokeDashArray="1 3" RenderTransformOrigin="0.5,0.5">
                    <Ellipse.RenderTransform>
                        <RotateTransform x:Name="TweaksSpinnerRotate" Angle="0"/>
                    </Ellipse.RenderTransform>
                </Ellipse>
                <Grid.Resources>
                    <Storyboard x:Key="SpinnerStoryboard">
                        <DoubleAnimation Storyboard.TargetName="TweaksSpinnerRotate"
                                        Storyboard.TargetProperty="Angle"
                                        From="0" To="360" Duration="0:0:1" 
                                        RepeatBehavior="Forever"/>
                    </Storyboard>
                </Grid.Resources>
            </Grid>
            <TextBlock Name="TweaksProgressText"
                     Text="" VerticalAlignment="Center" FontSize="12"
                     Foreground="{DynamicResource TextFG}" Opacity="0.7"/>
        </StackPanel>
    </StackPanel>
    
    <TextBlock Name="TabDescriptionDebloat" Grid.Row="1"
             Text="" FontSize="12" Opacity="0.7"
             Margin="5,0,5,15"
             Foreground="{DynamicResource TextFG}"
             TextWrapping="Wrap"/>
    
    <ScrollViewer Grid.Row="2" 
                  Style="{StaticResource TabScrollViewer}"
                  VerticalScrollBarVisibility="Auto" 
                  HorizontalScrollBarVisibility="Disabled" 
                  Padding="5,0">
        <StackPanel Name="TweaksCategoriesPanel"/>
    </ScrollViewer>
</Grid>